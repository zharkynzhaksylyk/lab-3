import math


class Circle:
    def __init__(self, radius):
        self.radius = radius
        self.color = "синий"  

    def area(self):
        return math.pi * self.radius ** 2

    def diameter(self):
        return 2 * self.radius

    def circumference(self):
        return 2 * math.pi * self.radius

    def set_radius(self, radius):
        if radius > 0:
            self.radius = radius
        else:
            print("Радиус должен быть больше 0.")

    def info(self):
        print("Радиус:", self.radius)
        print("Диаметр:", round(self.diameter(), 2))
        print("Площадь:", round(self.area(), 2))
        print("Длина окружности:", round(self.circumference(), 2))
        print("Цвет:", self.color)
